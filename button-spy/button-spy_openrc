#!/sbin/openrc-run

name="button-spy"
description="postmarketOS GT-I9100 button menu displayed in tty1"
command="/usr/local/bin/button-spy"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/button-spy.log"
error_log="/var/log/button-spy.log"

depend() {
    need localmount
    after bootmisc
}
