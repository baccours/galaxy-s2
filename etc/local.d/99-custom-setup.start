#!/bin/sh
(
  # Wait 10 seconds for other services to settle
  sleep 10

  # Force terminal to recognize the 'linux' type to
  #   allow blanking after 1 minute of inactivity
  # Set value can be read at
  #   /sys/module/kernel/parameters/consoleblank
  # Redirecting to tty1 targets the physical screen
  TERM=linux setterm --blank 1 > /dev/tty1

  # Set screen brigthness to minimal
  echo 0 > /sys/class/backlight/spi3.0/brightness

  # Turn off bluetooth
  bluetooth-toggle off
) &
