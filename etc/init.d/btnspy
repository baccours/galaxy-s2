#!/sbin/openrc-run

description="Input Grabber and Power Manager"
command="/usr/local/bin/btnspy"
#command_args="> /dev/tty1 2>&1”
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
    need localmount
    after udev
    #after bootmisc
}

stop_post() {
    # Re-enable screen on service stop
    echo 0 > /sys/class/graphics/fb0/blank
}
